{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sanjeet3326/Glint/blob/main/schema/report.schema.json",
  "title": "Glint JSON report",
  "type": "object",
  "required": ["tool", "version", "schema_version", "target", "scanned_files", "skipped_files", "warnings",
               "risk_score", "risk_band", "summary", "findings", "suppressed", "baselined"],
  "properties": {
    "tool": {"type": "string", "enum": ["glint"]},
    "version": {"type": "string"},
    "schema_version": {"type": "integer", "enum": [1]},
    "target": {"type": "string"},
    "scanned_files": {"type": "array", "items": {"type": "string"}},
    "skipped_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {"path": {"type": "string"}, "reason": {"type": "string"}}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "risk_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "risk_band": {"type": "string", "enum": ["clean", "low", "medium", "high", "critical"]},
    "summary": {
      "type": "object",
      "required": ["critical", "high", "medium", "low"],
      "properties": {
        "critical": {"type": "integer"},
        "high": {"type": "integer"},
        "medium": {"type": "integer"},
        "low": {"type": "integer"}
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "suppressed": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "baselined": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["rule_id", "title", "severity", "confidence", "path", "line", "message", "evidence", "fix", "owasp"],
      "properties": {
        "rule_id": {"type": "string"},
        "title": {"type": "string"},
        "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "path": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "message": {"type": "string"},
        "evidence": {"type": "string"},
        "fix": {"type": "string"},
        "owasp": {"type": "string"}
      }
    }
  }
}
